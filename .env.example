HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Optional. When set, clients must connect to /voice?token=<value>.
VOICE_TOKEN=

# PCM16 little-endian, mono. The raw WebSocket protocol uses this rate both ways.
AUDIO_SAMPLE_RATE=16000
MAX_MESSAGE_BYTES=65536
MAX_UTTERANCE_SECONDS=30
# Vercel Hobby functions have a 300-second ceiling. Use 285 there for a clean close.
MAX_CONNECTION_SECONDS=3600
CLIENT_TIMEOUT_SECONDS=60

# Lower silence makes replies start sooner. Raise it in noisy environments.
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=450
VAD_MIN_SPEECH_MS=160
VAD_PRE_ROLL_MS=160

# tiny.en + INT8 + greedy decoding is the fastest small English CPU setup.
WHISPER_MODEL=models/whisper-tiny-en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_CPU_THREADS=0
WHISPER_DOWNLOAD_ROOT=models/whisper
WHISPER_LOCAL_FILES_ONLY=true

# Download with: uv run python scripts/download_models.py
PIPER_MODEL=models/en_US-lessac-low.onnx
PIPER_USE_CUDA=false

# One job avoids CPU contention on small hosts. Increase only after measuring.
MAX_INFERENCE_JOBS=1
